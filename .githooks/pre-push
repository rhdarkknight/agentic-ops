#!/bin/sh
# Refuse push if the secret scanner finds keys, tokens, LAN IPs, or private-key blocks.
root=$(git rev-parse --show-toplevel)
python3 "$root/scripts/scan_secrets.py" --root "$root"
status=$?
if [ "$status" -ne 0 ]; then
  echo "REFUSING PUSH: secret scan failed (exit $status)" >&2
  exit 1
fi
exit 0
